<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="纸盒包装创意工作台" Width="1440" Height="920" MinWidth="1080" MinHeight="720" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Inter, Microsoft YaHei UI, Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
 <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="White" Padding="24,0"><Grid>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="StudioLogo" Width="40" Height="40"/><TextBlock Text="纸盒包装创意工作台" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="CreateNav" Content="创作" Background="{StaticResource Hover}" Margin="0,0,8,0"/><Button x:Name="Open" Content="项目" ToolTip="打开已保存的项目"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="Save" Content="保存"/><Button x:Name="Export" Content="导出" Margin="8,0"/><Button x:Name="Settings" Style="{StaticResource IconButton}" ToolTip="API 设置" AutomationProperties.Name="API 设置"><Path Data="M14,17 H5 M19,7 H10 M20,17 A3,3 0 1 1 14,17 A3,3 0 1 1 20,17 M10,7 A3,3 0 1 1 4,7 A3,3 0 1 1 10,7"/></Button></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" x:Name="WorkspaceGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition/><ColumnDefinition x:Name="InspectorColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24,24,8"><StackPanel>
     <StackPanel x:Name="ProductSettings" Margin="0,0,0,24"><TextBlock Text="产品参数 · 必填" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <TextBlock Text="笔的类型" Style="{StaticResource Label}"/><ComboBox x:Name="PenType" AutomationProperties.Name="笔的类型"/><TextBlock x:Name="PenPlacementHint" Style="{StaticResource Hint}" Margin="0,8,0,16"/>
      <TextBlock Text="支数" Style="{StaticResource Label}"/><TextBox x:Name="MarkerCount" MaxLength="6" AutomationProperties.Name="笔的支数（必填）" Margin="0,0,0,16"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="完整笔长 / mm" Style="{StaticResource Label}"/><TextBox x:Name="MarkerLength" MaxLength="10" AutomationProperties.Name="完整笔长，毫米（必填）"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="直径 / mm" Style="{StaticResource Label}"/><TextBox x:Name="MarkerDiameter" MaxLength="10" AutomationProperties.Name="单支笔直径，毫米（必填）"/></StackPanel></Grid>
       <TextBlock Text="托盘高度 / mm（选填）" Style="{StaticResource Label}" Margin="0,16,0,0"/><TextBox x:Name="TrayHeight" MaxLength="10" AutomationProperties.Name="统一托盘高度，毫米；留空自动计算"/>
     </StackPanel>
     <TextBlock Text="设计需求" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <Grid><TextBox x:Name="Request" Height="152" AcceptsReturn="True" MaxLength="10000" Padding="16" FontSize="14" AutomationProperties.Name="包装设计需求"/><TextBlock Text="想做什么样的包装？&#10;&#10;描述主题、风格和使用方式…" Foreground="{StaticResource Muted}" Margin="16" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Request}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <Expander x:Name="UnderstandingSettings" Header="上次需求理解" Visibility="Collapsed"><TextBlock x:Name="UnderstandingPreview" LineHeight="24"/></Expander>
     <Expander x:Name="SizeSettings" Header="包装尺寸"><StackPanel><TextBlock Text="商品尺寸上限" Style="{StaticResource Label}"/><ComboBox x:Name="SizeTier" AutomationProperties.Name="商品尺寸档位"/>
      <StackPanel x:Name="CustomSizePanel" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock Text="含外包装尺寸 / mm" Style="{StaticResource Label}"/><UniformGrid Columns="3"><TextBox x:Name="OuterLongest" MaxLength="10" AutomationProperties.Name="含外包装最长边上限，毫米"/><TextBox x:Name="OuterMiddle" MaxLength="10" AutomationProperties.Name="含外包装次长边上限，毫米" Margin="8,0"/><TextBox x:Name="OuterShortest" MaxLength="10" AutomationProperties.Name="含外包装最短边上限，毫米"/></UniformGrid></StackPanel>
      <TextBlock Text="每边外包装预留 / cm" Style="{StaticResource Label}" Margin="0,16,0,8"/><ComboBox x:Name="AllowanceCm" SelectedIndex="2" AutomationProperties.Name="每边外包装预留厘米数"><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox><TextBlock x:Name="PackagingLimitHint" Style="{StaticResource Hint}" Margin="0,16,0,8"/><TextBlock x:Name="PackagingEstimateHint" Style="{StaticResource Hint}"/>
     </StackPanel></Expander>
     <Expander Header="材料与补充要求"><StackPanel><TextBlock Text="材料、预算、市场或必须保留的条件" Style="{StaticResource Hint}" Margin="0,0,0,8"/><TextBox x:Name="Details" Height="104" AcceptsReturn="True" MaxLength="4000" AutomationProperties.Name="补充条件"/><TextBlock x:Name="SizeHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Expander>
     <Expander x:Name="ReferenceSettings" Header="reference"><StackPanel><ComboBox x:Name="ReferenceMode" SelectedIndex="0" Margin="0,0,0,12" AutomationProperties.Name="参考图使用模式"><ComboBoxItem Content="自由创意 · 3 个方向" Tag="creative"/><ComboBoxItem Content="还原现有结构 · 1 个方向" Tag="restore"/><ComboBoxItem Content="保留结构 · 3 个变体" Tag="variants"/></ComboBox><DockPanel><TextBlock x:Name="PictureCount" DockPanel.Dock="Right" Text="0 / 6" Style="{StaticResource Hint}" VerticalAlignment="Center"/><Button x:Name="AddPictures" Content="添加图片" Style="{StaticResource Outline}" HorizontalAlignment="Left"/></DockPanel><WrapPanel x:Name="AttachmentList" Margin="0,16,0,0"/><TextBlock x:Name="ReferenceSummary" TextWrapping="Wrap" Margin="0,8,0,8" Visibility="Collapsed"/><Button x:Name="ConfirmReference" Content="核对并确认结构" Style="{StaticResource Outline}" Visibility="Collapsed"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="1" Padding="24,16,24,24" Background="White"><StackPanel><Button x:Name="Generate" Content="生成设计" Style="{StaticResource Primary}" Height="48" FontSize="14"/><Button x:Name="ContinueGeneration" Content="继续生成" Style="{StaticResource Outline}" Height="40" Margin="0,8,0,0" Visibility="Collapsed"/><TextBlock x:Name="ApiHint" Text="一次生成 3 个创意方向" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
   </Grid></Border>
   <Grid x:Name="CanvasArea" Grid.Column="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button x:Name="Cancel" DockPanel.Dock="Right" Content="取消生成" Visibility="Collapsed"/><TextBlock x:Name="ResultTitle" Text="创作" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="ResultHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel>
    <Grid Grid.Row="1">
     <Border x:Name="Empty" Background="Transparent"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"><Path Data="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z M3.3 7l8.7 5 8.7-5 M12 22V12" Stroke="#999995" Width="40" Height="40" Margin="0,0,0,24"/><TextBlock Text="你的下一个包装创意" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="从左侧描述开始，或先添加一张 reference。" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,16,0,24"/><Button x:Name="AddReferenceEmpty" Content="添加 reference" Style="{StaticResource Outline}" HorizontalAlignment="Center"/></StackPanel></Border>
     <ScrollViewer x:Name="Results" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,24,0,16"><UniformGrid x:Name="ConceptCards" Columns="3" VerticalAlignment="Center"/></ScrollViewer>
     <Grid x:Name="DetailView" Visibility="Collapsed" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><ComboBox x:Name="Versions" DockPanel.Dock="Right" Width="152" AutomationProperties.Name="设计版本"/><TextBlock x:Name="SelectedTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel><ScrollViewer x:Name="ImageViewport" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both"><Grid><Image x:Name="ResultImage" Stretch="Uniform" Visibility="Collapsed"/><StackPanel x:Name="ImagePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"><TextBlock x:Name="ImageLabel" TextAlignment="Center" FontSize="18"/><TextBlock x:Name="ImageHint" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,16,0,0"/></StackPanel></Grid></ScrollViewer>
      <Border x:Name="FloatingTools" Grid.Row="2" HorizontalAlignment="Center" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,16,0,8"><WrapPanel x:Name="ToolItems"><Button x:Name="ZoomOut" Content="−" Style="{StaticResource IconButton}" ToolTip="缩小" AutomationProperties.Name="缩小"/><Button x:Name="ZoomReset" Content="100%" Padding="4,8" Width="48" ToolTip="重置缩放"/><Button x:Name="ZoomIn" Content="+" Style="{StaticResource IconButton}" ToolTip="放大" AutomationProperties.Name="放大"/><Border Width="1" Background="{StaticResource Line}" Margin="4,8"/><Button x:Name="ViewMenu" Content="视图"/><Button x:Name="Compare" Content="对比"/><Button x:Name="More" Style="{StaticResource IconButton}" ToolTip="更多操作" AutomationProperties.Name="更多操作"><Path Data="M4,12 L4.1,12 M12,12 L12.1,12 M20,12 L20.1,12" StrokeThickness="3"/></Button></WrapPanel></Border>
      </Grid>
     <Border x:Name="AgentProgress" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="330" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Panel.ZIndex="2">
      <StackPanel><TextBlock Text="设计进度" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock x:Name="AgentStep1" Text="○ 理解设计需求" Margin="0,4" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="AgentStep2" Text="○ 检索包装知识库" Margin="0,4" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="AgentStep3" Text="○ 分析参考草图" Margin="0,4" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="AgentStep4" Text="○ 计算包装尺寸和排列方式" Margin="0,4" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="AgentStep5" Text="○ 构思创意方案" Margin="0,4" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="AgentStep6" Text="○ 生成结构草图 / 效果图" Margin="0,4" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="AgentStep7" Text="○ 检查生成结果" Margin="0,4" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Border>
     </Grid>
    <Border x:Name="ChatBar" Grid.Row="2" Visibility="Collapsed" MaxWidth="640" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,8" Margin="0,8,0,0"><DockPanel><Button x:Name="Revise" DockPanel.Dock="Right" Style="{StaticResource Primary}" Width="40" Height="40" Padding="10" IsEnabled="False" ToolTip="修改选中方案" AutomationProperties.Name="发送修改"><Path Data="M12,19 L12,5 M5,12 L12,5 19,12"/></Button><Grid Margin="0,0,8,0"><TextBox x:Name="Feedback" BorderThickness="0" Padding="0,8" AcceptsReturn="False" MaxLength="5000" AutomationProperties.Name="修改意见"/><TextBlock Text="保留盒型，改变配色…" Foreground="{StaticResource Muted}" Margin="0,8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Feedback}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
    <Border x:Name="RunnerPanel" Grid.RowSpan="3" Visibility="Collapsed" VerticalAlignment="Bottom" Background="White" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,8" Padding="16"><StackPanel><Grid><TextBlock Text="创意正在路上" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="RunnerScore" Text="得分 0000  ·  最佳 0000" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/></Grid><Canvas x:Name="RunnerTrack" Height="196" Background="Transparent" ClipToBounds="True" Focusable="True" AutomationProperties.Name="变色龙滑板，空格跳跃，右方向键发射Ohuhu马克笔，下方向键盾牌弹反"/><TextBlock x:Name="RunnerHint" Text="点击跑道，空格跳跃，→ 发射马克笔，↓ 盾牌弹反" Style="{StaticResource Hint}"/></StackPanel></Border>
   </Grid>
   <Border x:Name="InspectorPanel" Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><DockPanel Margin="0,0,0,24"><Button x:Name="CloseDetails" DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="返回方案" AutomationProperties.Name="关闭详情"><Path Data="M6,6 L18,18 M18,6 L6,18"/></Button><TextBlock Text="方案详情" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="InspectorTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,24"/><Expander Header="设计理念"><TextBlock x:Name="CreativeDetails" LineHeight="24"/></Expander><Expander Header="盒型与结构"><TextBlock x:Name="StructureDetails" LineHeight="24"/></Expander><Expander Header="开合与使用"><TextBlock x:Name="OpeningDetails" LineHeight="24"/></Expander><Expander Header="内部排列"><TextBlock x:Name="LayoutDetails" LineHeight="24"/></Expander><Expander Header="创意亮点"><TextBlock x:Name="InnovationDetails" LineHeight="24"/></Expander><Expander Header="计算尺寸"><TextBlock x:Name="CalculationDetails" LineHeight="24"/></Expander><Expander Header="逐条需求落实"><TextBlock x:Name="RequirementDetails" LineHeight="24"/></Expander><Expander Header="制造与装配推导"><TextBlock x:Name="ManufacturingDetails" LineHeight="24"/></Expander><Expander Header="资料依据"><TextBlock x:Name="EvidenceDetails" LineHeight="24"/></Expander><Expander Header="材料与生产可行性"><TextBlock x:Name="EngineeringDetails" LineHeight="24"/></Expander><Expander Header="需求理解与待确认"><StackPanel><TextBlock x:Name="Brief" LineHeight="24"/><TextBlock x:Name="Missing" LineHeight="24" Margin="0,16,0,0"/></StackPanel></Expander><Expander Header="版本与修改记录"><StackPanel><TextBlock x:Name="RevisionTarget" Margin="0,0,0,8"/><TextBlock x:Name="FeedbackHint" Style="{StaticResource Hint}"/><StackPanel x:Name="Conversation" Margin="0,16,0,0"/></StackPanel></Expander><Expander Header="图片说明"><TextBlock x:Name="ImageCaption" Style="{StaticResource Hint}"/></Expander></StackPanel></ScrollViewer></Border>
   <Popup x:Name="ViewPopup" PlacementTarget="{Binding ElementName=ViewMenu}" Placement="Top" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8"><StackPanel><Button x:Name="ViewOverall" Content="整体效果"/><Button x:Name="ViewOpen" Content="打开状态"/><Button x:Name="ViewLayout" Content="内部布局"/><Button x:Name="ViewSketch" Content="设计草图"/></StackPanel></Border></Popup>
   <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=More}" Placement="Top" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8"><StackPanel><Button x:Name="RetryImage" Content="生成此视图"/><Button x:Name="ViewKnowledgeReport" Content="查看诊断报告"/><Button x:Name="RepairKnowledge" Content="修复知识库"/></StackPanel></Border></Popup>
  </Grid>
  <DockPanel Grid.Row="2" Margin="24,0"><TextBlock x:Name="Status" Text="就绪" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
